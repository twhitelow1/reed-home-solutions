---
// Circular brand mark: hand-drawn ring, two peaks, copper sun. Placeholder until the
// designed logo is approved (Jace asked for a circle that works as a profile icon). TODO
interface Props { size?: number; light?: boolean }
const { size = 48, light = false } = Astro.props;
const ring = light ? '#e9efd9' : '#2f5233';
---
<svg class="mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <circle cx="32" cy="32" r="29" fill={light ? 'transparent' : '#f3f1e2'} />
  <path d="M32 3.6c15.9.2 28.6 12.8 28.4 28.6-.2 15.7-13 28.3-28.7 28.2C16 60.2 3.5 47.4 3.6 31.7 3.8 16.6 15.9 4.3 30.6 3.7" fill="none" stroke={ring} stroke-width="3.2" stroke-linecap="round" />
  <circle cx="43" cy="22" r="5" fill="#c06a2b" />
  <path d="M9.5 45 24 23.5l7 10 5.5-7 18 18.5" fill="none" stroke={ring} stroke-width="3.6" stroke-linejoin="round" stroke-linecap="round" />
  <path d="M20.5 29l3.5 2.6 3.2-3.1" fill="none" stroke={ring} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M14 50.5h36" stroke="#c06a2b" stroke-width="3" stroke-linecap="round" />
</svg>
