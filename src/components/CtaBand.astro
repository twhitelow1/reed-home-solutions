---
import Icon from './Icon.astro';
import { site, estimateHref, telHref } from '../data/site';
interface Props { title?: string; text?: string; button?: string }
const { title = 'Get a fast, free written estimate', text = 'Tell us about the project. Jace walks the space with you, answers questions on the spot and sends a written, line-item estimate. No pressure, no vague numbers.', button = 'Request a free estimate' } = Astro.props;
---
<section class="section" aria-label={button}>
  <div class="wrap">
    <div class="cta">
      <Icon name="clipboard" class="cta-icon" />
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-copper" href={estimateHref}><Icon name="clipboard" />{button}</a>
        <a class="btn btn-ghost-light" href={telHref}><Icon name="phone" />Call {site.phone}</a>
      </div>
    </div>
  </div>
</section>
