---
// Jace's approved horizontal logo (mountains, roofline, REED HOME SOLUTIONS). Other cuts: public/logo-stacked.webp, logo.png, mark.webp.
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
---
<img class="logo" src="/logo-horizontal.webp" width="996" height="180" alt="Reed Home Solutions: remodel, renovate, build" decoding="async" loading={footer ? 'lazy' : 'eager'} fetchpriority={footer ? 'auto' : 'high'} />
