---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, serviceGroups } from '../../data/services';
import { breadcrumbs, webPage } from '../../lib/schema';
import { site } from '../../data/site';
const path = '/services';
const title = 'Remodeling Services in the Vail Valley | Reed Home Solutions';
const description = 'Kitchen, bath, basement and lock-off remodels, decks, siding, roofing, windows, flooring and insurance repairs across the Vail Valley. One local contractor.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path }];
const list = { '@type': 'ItemList', name: 'Remodeling services', itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/${s.slug}`, name: s.name })) };
---
<Base title={title} description={description} path={path} schema={[webPage(path, title, description, 'CollectionPage'), breadcrumbs(crumbs), list]}>
  <header class="page-head"><div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Remodeling and construction services</h1>
    <p class="answer">Reed Home Solutions offers {services.length} remodeling and construction services across Eagle County and nearby mountain towns. Interior remodels are our core work; exterior, roofing, window and flooring projects are installed by trusted local trade partners and managed by us, so one contractor is accountable for the whole job.</p>
  </div></header>
  {serviceGroups.map((g, i) => (
    <section class={`section ${i % 2 ? 'tint' : ''}`} aria-labelledby={`g${i}`}>
      <div class="wrap">
        <h2 id={`g${i}`}>{g}</h2>
        <div class="grid grid-2">
          {services.filter((s) => s.group === g).map((s) => (
            <article class="card"><Icon name={s.icon} class="icon-lg" /><div><h3><a href={`/${s.slug}`}>{s.name}</a></h3><p>{s.card}</p><span class="more">{s.name}<Icon name="chevron" /></span></div></article>
          ))}
        </div>
      </div>
    </section>
  ))}
  <CtaBand />
</Base>
