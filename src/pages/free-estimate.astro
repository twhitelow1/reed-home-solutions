---
// Free-estimate form. Posts to /api/estimate, which creates/updates the contact in Lead Alchemist,
// fills the custom fields and enrolls it in the estimate workflow. If that fails, the visitor
// gets the old fallback: their project summary ready to send by text or email in one tap.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { site, telHref } from '../data/site';
import { services } from '../data/services';
import { locations } from '../data/locations';
import { breadcrumbs, webPage, faqPage } from '../lib/schema';
const path = '/free-estimate';
const title = 'Free Remodeling Estimate | Vail Valley | Reed Home Solutions';
const description = 'Request a free, written remodeling or insurance repair estimate in the Vail Valley. Answer five quick questions and send your project to our team.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Free Estimate', path }];
const faqs = [
  { q: 'Is the estimate really free?', a: 'Yes. The site visit and written estimate are free and carry no obligation.' },
  { q: 'What happens after I send my project?', a: 'We review the details and photos, call or text to schedule a site visit, then send a written, itemized estimate.' },
  { q: 'What should I have ready?', a: 'A rough idea of what you want, photos of the space, any plans or inspiration images, your timeline, and your insurance claim number if it is a claim.' },
  { q: 'Do you charge for insurance estimates?', a: 'No. We prepare repair estimates for insurance projects as part of quoting the rebuild.' },
];
const webApp = { '@type': 'WebApplication', name: 'Remodeling project planner', url: `${site.url}${path}`, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, provider: { '@id': `${site.url}/#organization` } };
// Choice values match the options of Reed's Lead Alchemist dropdown fields exactly (labels can differ).
const timelines: [string, string][] = [['Urgent', 'Urgent (active damage)'], ['ASAP', 'As soon as possible'], ['1-3 Months', 'Within 1–3 months'], ['3-6 Months', '3–6 months'], ['Planning Phase', 'Just planning']];
const claims: [string, string][] = [['No', 'No'], ['Yes - Water/Freeze Damage', 'Yes, water or freeze damage'], ['Yes - Storm/Roof Damage', 'Yes, storm or roof damage'], ['Not sure yet', 'Not sure yet']];
const propertyTypes: [string, string][] = [['Single Family Home', 'Single-family home'], ['Condo-Townhome', 'Condo or townhome'], ['Commercial-HOA', 'Commercial or HOA']];
---
<Base title={title} description={description} path={path} schema={[webPage(path, title, description), webApp, breadcrumbs(crumbs), faqPage(faqs, path)]}>
  <header class="page-head"><div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Get a free remodeling estimate</h1>
    <p class="answer">Answer five quick questions and send your project straight to our team by text or email. We will follow up to schedule a site visit and send a written, itemized estimate. Prefer to talk? Call <a href={telHref}>{site.phone}</a>.</p>
  </div></header>
  <section class="section"><div class="wrap article">
    <div>
      <h2 style="font-size:1.5rem">Tell us about your project</h2>
      <form class="planner" id="planner" data-phone={site.phoneE164} data-email={site.email} novalidate>
        <fieldset>
          <legend>1. What is the project?</legend>
          <div class="choices">
            {services.map((s, i) => <label><input type="radio" name="project" value={s.name} required checked={i === 0} /><span>{s.name}</span></label>)}
            <label><input type="radio" name="project" value="Something else" /><span>Something else</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>2. Is this an insurance claim?</legend>
          <div class="choices">
            {claims.map(([v, l], i) => <label><input type="radio" name="insurance" value={v} checked={i === 0} /><span>{l}</span></label>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>3. When do you want to start?</legend>
          <div class="choices">
            {timelines.map(([v, l], i) => <label><input type="radio" name="timeline" value={v} checked={i === 2} /><span>{l}</span></label>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>4. What type of property?</legend>
          <div class="choices">
            {propertyTypes.map(([v, l], i) => <label><input type="radio" name="property_type" value={v} checked={i === 0} /><span>{l}</span></label>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>5. Are you the homeowner?</legend>
          <div class="choices">
            <label><input type="radio" name="homeowner" value="Yes" checked /><span>Yes</span></label>
            <label><input type="radio" name="homeowner" value="No" /><span>No (agent, manager, tenant)</span></label>
          </div>
        </fieldset>
        <div class="field-row">
          <div class="field">
            <label for="town">6. Where is the property?</label>
            <select id="town" name="town">
              {locations.map((l) => <option>{l.town}</option>)}
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="name">7. Your name</label>
            <input id="name" name="name" autocomplete="name" required />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" />
          </div>
        </div>
        <fieldset>
          <legend>Best way to reach you?</legend>
          <div class="choices">
            <label><input type="radio" name="contact_method" value="Phone" checked /><span>Call</span></label>
            <label><input type="radio" name="contact_method" value="Text" /><span>Text</span></label>
            <label><input type="radio" name="contact_method" value="Email" /><span>Email</span></label>
          </div>
        </fieldset>
        <div class="field">
          <label for="details">Anything else? (optional)</label>
          <textarea id="details" name="details" rows="3" placeholder="Size of the space, what you want to change, HOA, claim number…"></textarea>
        </div>
        <div class="consent">
          <label><input type="checkbox" name="sms_consent" value="yes" /><span>I agree to receive text messages from Reed Home Solutions about my estimate request, including scheduling and project updates. Message frequency varies. Message and data rates may apply. Reply STOP to opt out, HELP for help.</span></label>
          <label><input type="checkbox" name="marketing_consent" value="yes" /><span>I agree to receive occasional marketing and promotional text messages from Reed Home Solutions. Message frequency varies. Message and data rates may apply. Reply STOP to unsubscribe at any time.</span></label>
          <p class="meta">Optional. Consent is not a condition of any purchase. See our <a href="/privacy-policy">privacy policy</a>.</p>
        </div>
        <div class="hp" aria-hidden="true"><label>Company website <input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn-copper" type="submit" id="planner-submit" data-track="planner_complete"><Icon name="clipboard" />Send my estimate request</button>
        <p class="meta" id="planner-err" role="alert" hidden>Please add your name and a phone number or email so we can reach you.</p>
        <div class="planner-out planner-done" id="planner-done" hidden aria-live="polite" tabindex="-1">
          <b>Thanks, your request is in.</b>
          {site.callbackCalendarUrl ? (
            <>
              <p>Pick a time for a quick call back and we'll go over your project. Want to add photos? Text them to <a href={`sms:${site.phoneE164}`}>{site.phone}</a>.</p>
              <iframe id="callback-cal" class="callback-cal" data-src={site.callbackCalendarUrl} title="Schedule a call back with Reed Home Solutions" loading="lazy"></iframe>
            </>
          ) : (
            <p>We'll call or text you to schedule a site visit. Want to add photos of the space? Text them to <a href={`sms:${site.phoneE164}`}>{site.phone}</a>.</p>
          )}
        </div>
        <div class="planner-out" id="planner-out" hidden aria-live="polite">
          <b>We couldn't send that automatically. Send it in one tap instead:</b>
          <pre id="summary"></pre>
          <div class="btn-row">
            <a class="btn btn-primary" id="send-sms" href="#" data-track="lead_text"><Icon name="message" />Text it to us</a>
            {site.email && <a class="btn btn-outline" id="send-mail" href="#" data-track="lead_email"><Icon name="mail" />Email it</a>}
          </div>
          <p class="meta">Tip: attach a few photos of the space to your text or email.</p>
        </div>
      </form>
    </div>
    <aside class="aside">
      <div class="box dark">
        <h3>Rather talk it through?</h3>
        <p style="font-size:.95rem">Call us directly. Most site visits can be scheduled on the first call.</p>
        <a class="btn btn-copper" href={telHref}><Icon name="phone" />Call {site.phone}</a>
      </div>
      <div class="box">
        <h3>What happens next</h3>
        <ol style="margin:0;padding-left:1.1rem;font-size:.95rem">
          <li>We review your project</li>
          <li>We schedule a site visit</li>
          <li>You get a written, itemized estimate</li>
        </ol>
      </div>
    </aside>
  </div></section>
  <section class="section tint"><div class="wrap narrow"><Faq faqs={faqs} /></div></section>
  <script is:inline>
  (function () {
    var f = document.getElementById('planner'); if (!f) return;
    var out = document.getElementById('planner-out'), err = document.getElementById('planner-err');
    var btn = document.getElementById('planner-submit'), done = document.getElementById('planner-done');
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var d = new FormData(f), v = function (k) { return (d.get(k) || '').toString().trim(); };
      var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email')), phoneOk = v('phone').replace(/\D/g, '').length >= 10;
      if (!v('name') || (!emailOk && !phoneOk) || (v('email') && !emailOk && !phoneOk)) {
        err.textContent = !v('name') ? 'Please add your name.' : (v('email') && !emailOk) ? 'That email doesn’t look right. Check it, or add a phone number instead.' : 'Please add a phone number (10 digits) or an email so we can reach you.';
        err.hidden = false; err.scrollIntoView({ behavior: 'smooth', block: 'center' }); return;
      }
      err.hidden = true;
      var lines = ['Project: ' + v('project'), 'Insurance claim: ' + v('insurance'), 'Timeframe: ' + v('timeline'), 'Property: ' + v('property_type') + (v('homeowner') === 'No' ? ' (not the owner)' : ''), 'Location: ' + v('town'), 'Name: ' + v('name'), 'Best way to reach me: ' + v('contact_method')];
      if (v('phone')) lines.push('Phone: ' + v('phone'));
      if (v('email')) lines.push('Email: ' + v('email'));
      if (v('details')) lines.push('Details: ' + v('details'));
      var at = window.rhsAttribution || {}, la = at.last || {}, fi = at.first || {};
      var payload = { name: v('name'), phone: v('phone'), email: v('email'), project: v('project'), insurance_claim: v('insurance'), timeline: v('timeline'), property_type: v('property_type'), homeowner: v('homeowner'), town: v('town'), contact_method: v('contact_method'), details: v('details'), sms_consent: !!d.get('sms_consent'), marketing_consent: !!d.get('marketing_consent'), company_website: v('company_website'),
        lead_channel: la.channel || '', lead_source: la.utm_source || '', lead_medium: la.utm_medium || '', lead_campaign: la.utm_campaign || '', gclid: la.gclid || '', first_channel: fi.channel || '', landing_page: fi.landing_page ? location.origin + fi.landing_page : '', page: location.pathname };
      var label = btn.innerHTML; btn.disabled = true; btn.textContent = 'Sending…';
      if (window.dataLayer) window.dataLayer.push({ event: 'planner_complete', project: v('project'), town: v('town'), insurance: v('insurance') });
      function fallback() {
        var text = 'Hi, I would like a free estimate.\n' + lines.join('\n');
        document.getElementById('summary').textContent = lines.join('\n');
        document.getElementById('send-sms').href = 'sms:' + f.dataset.phone + '?&body=' + encodeURIComponent(text);
        var m = document.getElementById('send-mail');
        if (m) m.href = 'mailto:' + f.dataset.email + '?subject=' + encodeURIComponent('Free estimate request: ' + v('project') + ' in ' + v('town')) + '&body=' + encodeURIComponent(text);
        out.hidden = false; btn.disabled = false; btn.innerHTML = label;
        out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      fetch('/api/estimate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return r.status === 422 ? 'invalid' : r.ok && j.ok; }); })
        .then(function (ok) {
          if (ok === 'invalid') { btn.disabled = false; btn.innerHTML = label; err.textContent = 'Please add a phone number (10 digits) or an email so we can reach you.'; err.hidden = false; return; }
          if (!ok) return fallback();
          f.querySelectorAll('fieldset, .field-row, .field, .hp, #planner-submit').forEach(function (el) { el.hidden = true; });
          out.hidden = true; done.hidden = false; done.focus();
          var cal = document.getElementById('callback-cal');
          if (cal) {
            // Prefill the booking widget with what they just typed, and carry the lead's source.
            var u = new URL(cal.dataset.src), parts = v('name').split(/\s+/);
            var pre = { first_name: parts[0] || '', last_name: parts.slice(1).join(' '), phone: v('phone'), email: v('email'), utm_source: la.utm_source || '', utm_medium: la.utm_medium || '', utm_campaign: la.utm_campaign || '' };
            Object.keys(pre).forEach(function (k) { if (pre[k]) u.searchParams.set(k, pre[k]); });
            cal.src = u.toString();
            if (!document.getElementById('ghl-embed')) { var sc = document.createElement('script'); sc.id = 'ghl-embed'; sc.src = 'https://link.msgsndr.com/js/form_embed.js'; document.body.appendChild(sc); }
            if (window.dataLayer) window.dataLayer.push({ event: 'callback_calendar_shown' });
          }
          done.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (window.dataLayer) window.dataLayer.push({ event: 'lead_submit', form: 'free_estimate', project: v('project'), town: v('town') });
          if (window.gtag) window.gtag('event', 'generate_lead', { form: 'free_estimate' });
        })
        .catch(fallback);
    });
  })();
  </script>
</Base>
