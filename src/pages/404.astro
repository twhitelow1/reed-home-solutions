---
import Base from '../layouts/Base.astro';
import { locations } from '../data/locations';
import { services } from '../data/services';
---
<Base title="Page not found | Reed Home Solutions" description="This page could not be found. Find remodeling services and service areas for Reed Home Solutions." path="/404" noindex>
  <section class="section"><div class="wrap narrow">
    <h1>That page isn’t here</h1>
    <p>The link may be old or mistyped. Try one of these instead:</p>
    <ul><li><a href="/">Home</a></li><li><a href="/services">Services</a></li><li><a href="/service-areas">Service areas</a></li><li><a href="/free-estimate">Free estimate</a></li><li><a href="/contact">Contact us</a></li></ul>
    <ul class="towns">{services.map((s) => <li><a href={`/${s.slug}`}>{s.name}</a></li>)}</ul>
    <ul class="towns">{locations.map((l) => <li><a href={`/${l.slug}`}>{l.town}</a></li>)}</ul>
  </div></section>
</Base>
