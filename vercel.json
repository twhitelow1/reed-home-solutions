{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/kitchen-remodeling",
      "destination": "/kitchen-remodeling-vail-co",
      "permanent": true
    },
    {
      "source": "/bathroom-remodeling",
      "destination": "/bathroom-remodeling-vail-co",
      "permanent": true
    },
    {
      "source": "/basement-lock-off-remodeling",
      "destination": "/basement-lock-off-remodeling-vail-co",
      "permanent": true
    },
    {
      "source": "/flooring-installation",
      "destination": "/flooring-installation-vail-co",
      "permanent": true
    },
    {
      "source": "/deck-building-repair",
      "destination": "/deck-building-repair-vail-co",
      "permanent": true
    },
    {
      "source": "/siding-exterior-painting",
      "destination": "/siding-exterior-painting-vail-co",
      "permanent": true
    },
    {
      "source": "/roof-replacement-repair",
      "destination": "/roof-replacement-repair-vail-co",
      "permanent": true
    },
    {
      "source": "/window-replacement",
